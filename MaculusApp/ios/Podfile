# Resolve through Node so hoisted React Native installations remain supported.
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve("react-native/scripts/react_native_pods.rb", {paths: [process.argv[1]]})', __dir__]).strip

# ExecuTorch and multimodal llama.rn use JSI/TurboModules. React Native 0.81's
# New Architecture flag must be identical during pod installation and the
# Xcode build. Compile the audited llama.cpp source so LFM2.5-VL and Metal are
# available without relying on a separately downloaded framework.
ENV['RCT_NEW_ARCH_ENABLED'] = '1'
ENV['RNLLAMA_BUILD_FROM_SOURCE'] = '1'

platform :ios, '18.2'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'MaculusApp' do
  config = use_native_modules!

  # App-local iOS parity layer: YOLO, depth, anonymous person ReID,
  # wake-word/barge-in capture, and the phone-camera fallback. ExecuTorch owns
  # command transcription through its auto-linked pods.
  pod 'TensorFlowLiteObjC', '2.17.0', :modular_headers => true
  pod 'onnxruntime-objc', '1.18.0', :modular_headers => true
  pod 'MaculusNative', :path => '..'

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :new_arch_enabled => true
  )

  target 'MaculusAppTests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Keep every Swift pod on the app's iOS 18.2 floor. Building MaculusNative
    # for the old React Native 13.4 default makes current Xcode emit references
    # to legacy swiftCompatibility libraries that its iPhoneOS toolchain no
    # longer ships at the auto-linked path.
    installer.pods_project.targets.each do |pod_target|
      pod_target.build_configurations.each do |build_configuration|
        build_configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '18.2'
      end
    end
  end
end
