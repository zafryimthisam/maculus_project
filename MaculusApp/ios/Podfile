require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'

# React Native's New Architecture remains enabled for the native camera and
# sensor modules. iOS VLM inference is provided by the Apple FastVLM framework;
# react-native.config.js disables llama.rn autolinking on iOS only.
ENV['RCT_NEW_ARCH_ENABLED'] = '1'

platform :ios, '18.2'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'MaculusApp' do
  config = use_native_modules!

  # App-local iOS parity layer: YOLO, depth, anonymous person ReID,
  # wake-word/command capture, and the phone-camera fallback.
  pod 'TensorFlowLiteObjC', '2.17.0', :modular_headers => true
  pod 'onnxruntime-objc', '1.18.0', :modular_headers => true
  pod 'MaculusNative', :path => '..'

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :new_arch_enabled => true
  )

  target 'MaculusAppTests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
  end
end
