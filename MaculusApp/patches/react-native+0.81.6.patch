diff --git a/node_modules/react-native/ReactCommon/react/utils/React-utils.podspec b/node_modules/react-native/ReactCommon/react/utils/React-utils.podspec
--- a/node_modules/react-native/ReactCommon/react/utils/React-utils.podspec
+++ b/node_modules/react-native/ReactCommon/react/utils/React-utils.podspec
@@ -50,1 +50,3 @@ Pod::Spec.new do |s|
-  depend_on_js_engine(s)
+  # React-jsc already links the engine into the app. Adding it here creates a
+  # React-jsc -> jsitooling -> runtimeexecutor -> utils -> React-jsc cycle.
+  s.dependency "hermes-engine" if use_hermes()
diff --git a/node_modules/react-native/scripts/cocoapods/jsengine.rb b/node_modules/react-native/scripts/cocoapods/jsengine.rb
--- a/node_modules/react-native/scripts/cocoapods/jsengine.rb
+++ b/node_modules/react-native/scripts/cocoapods/jsengine.rb
@@ -37,1 +37,3 @@ def use_third_party_jsc_flags
-  return "-DUSE_THIRD_PARTY_JSC=1"
+  # RCTCxxBridge treats an undefined USE_HERMES as Hermes enabled. Define it
+  # explicitly so third-party JSC builds do not import Hermes-only headers.
+  return " -DUSE_THIRD_PARTY_JSC=1 -DUSE_HERMES=0"
diff --git a/node_modules/react-native/Libraries/AppDelegate/RCTAppSetupUtils.mm b/node_modules/react-native/Libraries/AppDelegate/RCTAppSetupUtils.mm
--- a/node_modules/react-native/Libraries/AppDelegate/RCTAppSetupUtils.mm
+++ b/node_modules/react-native/Libraries/AppDelegate/RCTAppSetupUtils.mm
@@ -148,4 +148,6 @@ RCTAppSetupDefaultJsExecutorFactory(
 #if USE_THIRD_PARTY_JSC != 1
   return std::make_unique<facebook::react::HermesExecutorFactory>(
       facebook::react::RCTJSIExecutorRuntimeInstaller(runtimeInstallerLambda));
+#else
+  return nullptr;
 #endif
@@ -166,4 +168,6 @@ RCTAppSetupJsExecutorFactoryForOldArch(
 #if USE_THIRD_PARTY_JSC != 1
   return std::make_unique<facebook::react::HermesExecutorFactory>(
       facebook::react::RCTJSIExecutorRuntimeInstaller(runtimeInstallerLambda));
+#else
+  return nullptr;
 #endif
diff --git a/node_modules/react-native/Libraries/AppDelegate/RCTDefaultReactNativeFactoryDelegate.mm b/node_modules/react-native/Libraries/AppDelegate/RCTDefaultReactNativeFactoryDelegate.mm
--- a/node_modules/react-native/Libraries/AppDelegate/RCTDefaultReactNativeFactoryDelegate.mm
+++ b/node_modules/react-native/Libraries/AppDelegate/RCTDefaultReactNativeFactoryDelegate.mm
@@ -44,6 +44,9 @@
 - (JSRuntimeFactoryRef)createJSRuntimeFactory
 {
 #if USE_THIRD_PARTY_JSC != 1
   return jsrt_create_hermes_factory();
+#else
+  // Third-party engines are supplied by the application's delegate override.
+  return nullptr;
 #endif
 }
diff --git a/node_modules/react-native/scripts/react_native_pods.rb b/node_modules/react-native/scripts/react_native_pods.rb
--- a/node_modules/react-native/scripts/react_native_pods.rb
+++ b/node_modules/react-native/scripts/react_native_pods.rb
@@ -76,1 +76,3 @@ def use_react_native! (
-  hermes_enabled= true
+  # Respect the selected community JSC engine instead of forcing Hermes back
+  # into the pod graph after USE_THIRD_PARTY_JSC has opted out of it.
+  hermes_enabled = use_hermes()
